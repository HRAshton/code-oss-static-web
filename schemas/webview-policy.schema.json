{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "mode", "externalBaseUrlTemplate"],
  "properties": {
    "schemaVersion": {"const": 1},
    "mode": {"const": "disabled"},
    "externalBaseUrlTemplate": {"type": "string", "pattern": "^https://(?:[^/?#@]+\\.)*invalid\\.invalid(?::443)?(?:/|$)"}
  }
}
