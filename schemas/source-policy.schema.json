{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Codellei/code-oss-static-web/blob/master/schemas/source-policy.schema.json",
  "title": "Code OSS Static Web extension source policy",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "allowedOpenVsxRegistries",
    "allowedOpenVsxDownloadOrigins",
    "allowedMirrorOrigins",
    "requireMirrorForLockedExtensions"
  ],
  "properties": {
    "schemaVersion": { "const": 2 },
    "allowedOpenVsxRegistries": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^https://[^/?#@]+(?::[0-9]+)?/?$"
      }
    },
    "allowedOpenVsxDownloadOrigins": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^https://[^/?#@]+(?::[0-9]+)?/?$"
      }
    },
    "allowedMirrorOrigins": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^https://[^/?#@]+(?::[0-9]+)?/?$"
      }
    },
    "requireMirrorForLockedExtensions": { "type": "boolean" }
  }
}
