{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/HRAshton/code-oss-static-web/blob/master/schemas/source-policy.schema.json",
  "title": "Code OSS Static Web extension source policy",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "allowedOpenVsxRegistries"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "allowedOpenVsxRegistries": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^https://[^/?#@]+(?::[0-9]+)?/?$"
      }
    }
  }
}
