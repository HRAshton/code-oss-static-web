{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "repository", "tag", "commit", "sourceDateEpoch", "qualified", "qualificationNote"],
  "properties": {
    "schemaVersion": {"const": 1},
    "repository": {"const": "https://github.com/microsoft/vscode.git"},
    "tag": {"type": "string", "minLength": 1},
    "commit": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "sourceDateEpoch": {"type": "integer", "minimum": 1},
    "qualified": {"type": "boolean"},
    "qualificationNote": {"type": "string", "minLength": 1}
  }
}
