{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "default", "allowedOrigins"],
  "properties": {
    "schemaVersion": {"const": 1},
    "default": {"const": "deny"},
    "allowedOrigins": {
      "type": "array",
      "minItems": 1,
      "items": {"type": "string"}
    }
  }
}
