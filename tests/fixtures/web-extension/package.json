{
  "name": "code-oss-static-web-test",
  "displayName": "Code OSS Static Web Qualification",
  "publisher": "code-oss-static-web",
  "version": "0.0.0",
  "private": true,
  "license": "MIT",
  "engines": {
    "vscode": "^1.139.0"
  },
  "browser": "./extension.js",
  "activationEvents": [
    "onCommand:codeOssStaticWebTest.markReady",
    "onCommand:codeOssStaticWebTest.readMarker"
  ],
