{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:best-practices"
  ],
  "dependencyDashboard": true,
  "labels": [
    "dependencies"
  ],
  "packageRules": [
    {
      "description": "One platform PR updates VS Code tag, commit, source date epoch and Ubuntu snapshot",
      "matchManagers": [
        "custom.regex"
      ],
      "matchPackageNames": [
        "microsoft/vscode",
        "vscode-source-date-epoch",
        "ubuntu-snapshot"
      ],
      "groupName": "Code OSS platform and Ubuntu snapshot",
      "groupSlug": "code-oss-platform",
      "minimumGroupSize": 3,
      "separateMajorMinor": false,
      "semanticCommitType": "chore",
      "semanticCommitScope": "upstream",
      "commitMessageTopic": "Code OSS platform"
    },
    {
      "description": "Group routine GitHub Actions updates weekly",
      "matchManagers": ["github-actions"],
      "matchPackageNames": ["!anchore/sbom-action"],
      "matchUpdateTypes": ["minor", "patch", "digest"],
      "groupName": "Weekly GitHub Actions",
      "groupSlug": "weekly-github-actions",
      "schedule": ["* 0-5 * * 1"]
    }
  ],
  "platformAutomerge": true,
  "automergeStrategy": "merge-commit",
  "semanticCommits": "enabled",
  "semanticCommitType": "chore",
  "semanticCommitScope": "deps",
  "customManagers": [
    {
      "customType": "regex",
      "managerFilePatterns": [
        "/^upstream\\.lock\\.json$/"
      ],
      "matchStrings": [
        "\"tag\":\\s*\"(?<currentValue>[^\"]+)\",\\s*\\n\\s*\"commit\":\\s*\"(?<currentDigest>[0-9a-f]{40})\""
      ],
      "depNameTemplate": "microsoft/vscode",
      "datasourceTemplate": "github-tags",
      "versioningTemplate": "semver",
      "autoReplaceStringTemplate": "\"tag\": \"{{{newValue}}}\",\n  \"commit\": \"{{{newDigest}}}\""
    },
    {
      "customType": "regex",
      "managerFilePatterns": [
        "/^upstream\\.lock\\.json$/"
      ],
      "matchStrings": [
        "\"sourceDateEpoch\":\\s*(?<currentValue>\\d+)"
      ],
      "depNameTemplate": "vscode-source-date-epoch",
      "datasourceTemplate": "custom.vscode-source-date-epoch",
      "versioningTemplate": "regex:^(?<major>\\d+)$"
    },
    {
      "customType": "regex",
      "managerFilePatterns": [
        "/^builder-apt-snapshot\\.json$/"
      ],
      "matchStrings": [
        "\"aptSnapshot\":\\s*\"(?<currentValue>\\d{8}T\\d{6}Z)\""
      ],
      "depNameTemplate": "ubuntu-snapshot",
      "datasourceTemplate": "custom.ubuntu-snapshot",
      "versioningTemplate": "regex:^(?<major>\\d{4})(?<minor>\\d{2})(?<patch>\\d{2})T(?<build>\\d{6})Z$"
    }
  ],
  "commitMessageLowerCase": "never",
  "automerge": true,
  "automergeType": "pr",
  "customDatasources": {
    "vscode-source-date-epoch": {
      "defaultRegistryUrlTemplate": "https://api.github.com/repos/microsoft/vscode/releases/latest",
      "format": "json",
      "transformTemplates": [
        "{\"releases\":[{\"version\":$string($floor($toMillis(created_at)/1000))}],\"sourceUrl\":\"https://github.com/microsoft/vscode\"}"
      ]
    },
    "ubuntu-snapshot": {
      "defaultRegistryUrlTemplate": "https://api.github.com/repos/microsoft/vscode/releases/latest",
      "format": "json",
      "transformTemplates": [
        "{\"releases\":[{\"version\":$fromMillis($toMillis(published_at)-172800000,\"[Y0001][M01][D01]T000000Z\")}],\"sourceUrl\":\"https://snapshot.ubuntu.com/\"}"
      ]
    }
  }
}
